rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Course catalog: anyone (including logged-out visitors) can read the
    // catalog so programs.html can show it, but only the admin account can
    // create, edit, or delete courses.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'admin@bhf.com';
    }

    // Program categories: readable by everyone for listing, writable only
    // by the admin account so categories can be managed from the admin panel.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'admin@bhf.com';
    }

    // Overrides: admin can create/update/delete content overrides; anyone
    // can read them so the site applies the same overrides to all visitors.
    match /overrides/{overrideId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'admin@bhf.com';
    }

    // Certificates: anyone (including logged-out visitors, on any device)
    // can read a certificate to verify it by code. Only a signed-in user can
    // issue a certificate, and only for themselves (their auth email must
    // match the certificate's email) — so nobody can mint a certificate in
    // someone else's name. Only the admin can update/revoke or delete one.
    match /certificates/{certId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.email == request.resource.data.email;
      allow update, delete: if request.auth != null
                    && request.auth.token.email == 'admin@bhf.com';
    }

    // Default deny for anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
